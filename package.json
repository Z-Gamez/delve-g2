{
  "name": "delve",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.14 -o delve.ehpk",
    "simulate": "evenhub-simulator http://localhost:5175",
    "test": "node --experimental-strip-types test/llm.test.ts && node --experimental-strip-types test/speech.test.ts && node --experimental-strip-types test/engine.test.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@iconify-json/game-icons": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
